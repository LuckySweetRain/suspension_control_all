    {
      "source_slide": 13,
      "purpose": "spdf_method",
      "transition": "fade",
      "notes": "SPDF方法的核心是把周期滞后反馈引入滑模面，使误差在指定时间附近快速收敛。为了降低工程实现中的抖振风险，控制律采用连续切换形式，并通过Lyapunov分析给出稳定性论证。",
      "replacements": [
        {"slot_id": "s13_sh28", "text": "SPDF：周期滞后滑模控制方法"},
        {"slot_id": "s13_sh29", "text": "面向模型已知情形，实现垂向与俯仰误差的实用指定时间收敛"},
        {"slot_id": "s13_sh16", "text": "构造周期滞后滑模变量，将当前误差与滞后误差共同纳入滑模面。"},
        {"slot_id": "s13_sh17", "text": "设计连续滑模控制律，避免传统符号切换导致的高频抖振。"},
        {"slot_id": "s13_sh18", "text": "Lyapunov 稳定性证明"},
        {"slot_id": "s13_sh20", "text": "误差系统"},
        {"slot_id": "s13_sh21", "text": "稳定性证明"},
        {"slot_id": "s13_sh19", "text": "周期滞后反馈"},
        {"slot_id": "s13_sh4", "text": "h"}
      ]
    },
